{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "gh-runs-cleanup",
    "version": "1.0.1",
    "private": true,
    "description": "GitHub CLI extension to bulk-delete workflow runs with safe filters.",
    "keywords": [
        "gh",
        "gh-extension",
        "github-actions",
        "workflow-runs",
        "cleanup"
    ],
    "homepage": "https://github.com/Nick2bad4u/gh-runs-cleanup",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/gh-runs-cleanup/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/gh-runs-cleanup.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)",
    "contributors": [
        "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)"
    ],
    "type": "module",
    "bin": {
        "gh-runs-cleanup": "./gh-runs-cleanup"
    },
    "files": [
        "cleanup-workflow-runs.mjs",
        "gh-runs-cleanup",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "build:assets": "node scripts/build-gh-extension-assets.mjs",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/gh-runs-cleanup --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/gh-runs-cleanup --unreleased",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/gh-runs-cleanup --current",
        "dev": "node ./src/cli.ts",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:all": "npm run lint:prettier && npm run lint && npm run typecheck && npm run lint:gitleaks && npm run lint:yamllint",
        "lint:all:fix": "npm run lint:prettier:fix && npm run lint:fix && npm run lint:remark:fix && npm run typecheck",
        "lint:fix": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache --fix",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:jscpd": "jscpd --config node_modules/jscpd-config-nick2bad4u/jscpd.json",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml .",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md",
        "lint:package-json": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:prettier": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --check",
        "lint:prettier:fix": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --write",
        "lint:remark": "remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "remark . --ignore-path .remarkignore --output",
        "lint:yamllint": "yamllint -c .yamllint .",
        "release:check": "npm run lint:all && npm test",
        "start": "node ./src/cli.ts",
        "sync:node-version-files": "node scripts/sync-node-version-files.mjs",
        "test": "npm run build && node --test dist/test/**/*.test.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "update-actions": "npx actions-up --yes --style sha",
        "update-deps": "ncu --configFileName .ncurc.json --configFilePath node_modules/ncu-config-nick2bad4u && npm run sync:node-version-files && npm install --force"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@microsoft/tsdoc-config": "^0.18.1",
        "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
        "@types/node": "^26.1.1",
        "esbuild": "^0.28.1",
        "eslint": "^10.7.0",
        "eslint-config-nick2bad4u": "^5.0.0",
        "git-cliff": "^2.13.1",
        "gitcliff-config-nick2bad4u": "^1.3.0",
        "gitleaks-config-nick2bad4u": "^1.0.4",
        "globals": "^17.7.0",
        "jscpd": "^5.0.12",
        "jscpd-config-nick2bad4u": "^1.1.0",
        "lychee-config-nick2bad4u": "^2.0.0",
        "ncu-config-nick2bad4u": "^0.2.0",
        "npm-check-updates": "^22.2.9",
        "npm-package-json-lint": "^10.4.1",
        "npm-package-json-lint-config-nick2bad4u": "^1.0.4",
        "prettier": "^3.9.5",
        "prettier-config-nick2bad4u": "^1.1.1",
        "prettier-plugin-ini": "^1.3.0",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-merge": "^0.10.1",
        "prettier-plugin-multiline-arrays": "^4.1.10",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-properties": "^0.3.1",
        "prettier-plugin-sh": "^0.19.0",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-sql": "^0.20.0",
        "prettier-plugin-toml": "^2.0.6",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.1.3",
        "secretlint": "^13.0.2",
        "secretlint-config-nick2bad4u": "^1.1.2",
        "stylelint": "^17.14.0",
        "stylelint-config-nick2bad4u": "^1.0.20",
        "tsdoc-config-nick2bad4u": "^1.0.6",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.63.0",
        "yamllint-config-nick2bad4u": "^1.1.1"
    },
    "packageManager": "npm@12.0.1",
    "engines": {
        "node": ">=22.18.0"
    }
}
